{
  "name": "lavid-life",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,ts,tsx,json,css}\"",
    "deploy": "yarn build && firebase deploy --only hosting",
    "deploy:web": "yarn turbo run build --filter=@web/lavid-life && firebase deploy --only hosting:web-site",
    "deploy:admin": "yarn turbo run build --filter=admin && firebase deploy --only hosting:admin-site",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:emulators": "firebase emulators:start"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "turbo": "^2.9.6"
  }
}
